# The editor, the formatter and a coding agent need to agree on indentation and line endings before the
# formatter runs; otherwise each picks its own and the formatter fills the diff with noise.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.md]
# Markdown uses trailing spaces for a line break.
trim_trailing_whitespace = false
