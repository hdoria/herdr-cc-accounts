{
  "name": "herdr-cc-accounts",
  "version": "0.1.0",
  "description": "Claude Code accounts side by side in Herdr.app: one CLAUDE_CONFIG_DIR per account, and a panel that shows which one each pane uses.",
  "license": "MIT",
  "author": "Hugo Doria Nunes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.mod.json",
    "test": "node --test",
    "test:coverage": "c8 --check-coverage --lines 70 --branches 70 --functions 70 --statements 70 node --test",
    "build": "node scripts/check-package.mjs"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "c8": "12.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
